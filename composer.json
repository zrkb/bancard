{
    "name": "zrkb/bancard",
    "description": "A minimal implementation for Bancard API vPOS 2.0",
    "keywords": [
        "php",
        "bancard"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Felix Ayala",
            "email": "hi@felixaya.la"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Bancard\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bancard\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    }
}
